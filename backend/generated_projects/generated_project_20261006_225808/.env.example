# Application
APP_NAME=FastAPI JWT Authentication
ENVIRONMENT=development
DEBUG=true

# Database (used by the application and Alembic migrations)
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/fastapi_auth

# JWT authentication
# Generate a strong random value, for example: openssl rand -hex 32
SECRET_KEY=replace-with-a-strong-random-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
